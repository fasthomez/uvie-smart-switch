// Shared building blocks for the settings window — glyphs, theme colors,
// cards, rows, list sections. Panes in `pages/` compose these.

import { Button, ComboBox, LineEdit, ScrollView, Switch, Palette } from "std-widgets.slint";

export struct MacroItem {
    trigger: string,
    expansion: string,
}

// Segoe MDL2 Assets glyphs — the same icon set the WinUI window used
// (font ships on every Windows since Win8; PUA codepoints match).
export global UIGlyph {
    out property <string> settings: "\u{E713}";   // gear
    out property <string> keyboard: "\u{E765}";
    out property <string> pen: "\u{E8D2}";        // font / text
    out property <string> apps: "\u{E71D}";       // tiles
    out property <string> wrench: "\u{E90F}";     // repair
    out property <string> info: "\u{E946}";       // info circle
    out property <string> delete: "\u{E74D}";     // trash
    out property <string> switch: "\u{E8AB}";     // sync
    out property <string> search: "\u{E721}";
    out property <string> power: "\u{E7E8}";
    out property <string> bolt: "\u{E945}";       // lightning
    out property <string> book: "\u{E736}";       // dictionary
    out property <string> sun: "\u{E706}";        // brightness
}

export global UITheme {
    out property <color> secondary: Palette.foreground.with-alpha(0.55);
    out property <color> divider: Palette.foreground.with-alpha(0.07);
    out property <brush> accent-tint: Palette.accent-background.with-alpha(0.12);
    out property <brush> hover: Palette.foreground.with-alpha(0.06);
}

export component IconText inherits Text {
    in property <string> glyph;
    text: glyph;
    font-family: "Segoe MDL2 Assets";
    horizontal-alignment: center;
    vertical-alignment: center;
}

// Rounded-square chip behind a row icon — accent-tinted, like the colored
// chips in Win11 Settings.
export component IconChip inherits Rectangle {
    in property <string> glyph;
    in property <brush> chip-bg: UITheme.accent-tint;
    in property <brush> icon-fg: Palette.accent-background;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: chip-bg;
    IconText {
        glyph: root.glyph;
        font-size: 15px;
        color: root.icon-fg;
        width: 100%;
        height: 100%;
    }
}

// Elevated card: soft shadow instead of a hard border so it reads on top
// of the window background in both light and dark.
export component Card inherits Rectangle {
    border-radius: 8px;
    background: Palette.control-background;
    border-width: 1px;
    border-color: Palette.foreground.with-alpha(0.06);
    drop-shadow-blur: 12px;
    drop-shadow-color: #00000024;
    drop-shadow-offset-y: 2px;
    VerticalLayout {
        padding: 0px;
        spacing: 0px;
        @children
    }
}

export component SectionHeader inherits Text {
    font-size: 11px;
    font-weight: 600;
    color: UITheme.secondary;
}

export component RowDivider inherits Rectangle {
    height: 1px;
    background: UITheme.divider;
}

// icon-chip + (title, description) + Switch — uvie-mac `SToggleRow`.
export component ToggleRow inherits Rectangle {
    in property <string> glyph;
    in property <string> title;
    in property <string> desc;
    in-out property <bool> checked;
    callback toggled(bool);

    HorizontalLayout {
        padding-top: 12px;
        padding-bottom: 12px;
        padding-left: 14px;
        padding-right: 14px;
        spacing: 14px;

        IconChip {
            glyph: root.glyph;
        }

        VerticalLayout {
            spacing: 2px;
            alignment: center;
            Text {
                text: root.title;
                font-size: 13px;
                font-weight: 500;
                color: Palette.foreground;
                overflow: elide;
            }
            Text {
                text: root.desc;
                font-size: 12px;
                color: UITheme.secondary;
                wrap: word-wrap;
            }
        }

        Switch {
            checked <=> root.checked;
            toggled => root.toggled(self.checked);
        }
    }
}

// icon-chip + (title, description) + ComboBox picker.
export component ComboRow inherits Rectangle {
    in property <string> glyph;
    in property <string> title;
    in property <string> desc;
    in property <[string]> options;
    in-out property <int> index;
    callback selected(int);

    HorizontalLayout {
        padding-top: 12px;
        padding-bottom: 12px;
        padding-left: 14px;
        padding-right: 14px;
        spacing: 14px;

        IconChip {
            glyph: root.glyph;
        }

        VerticalLayout {
            spacing: 2px;
            alignment: center;
            Text {
                text: root.title;
                font-size: 13px;
                font-weight: 500;
                color: Palette.foreground;
                overflow: elide;
            }
            Text {
                text: root.desc;
                font-size: 12px;
                color: UITheme.secondary;
                wrap: word-wrap;
            }
        }

        ComboBox {
            model: root.options;
            current-index <=> root.index;
            changed current-index => root.selected(self.current-index);
        }
    }
}

// icon-chip + (title, description) row with no control — informational.
export component InfoRow inherits Rectangle {
    in property <string> glyph;
    in property <string> title;
    in property <string> desc;

    HorizontalLayout {
        padding-top: 12px;
        padding-bottom: 12px;
        padding-left: 14px;
        padding-right: 14px;
        spacing: 14px;

        IconChip {
            glyph: root.glyph;
        }

        VerticalLayout {
            spacing: 2px;
            alignment: center;
            Text {
                text: root.title;
                font-size: 13px;
                font-weight: 500;
                color: Palette.foreground;
                overflow: elide;
            }
            Text {
                text: root.desc;
                font-size: 12px;
                color: UITheme.secondary;
                wrap: word-wrap;
            }
        }
    }
}

// "SECTION CAPTION" + card — caller writes the caption in uppercase.
export component Section inherits VerticalLayout {
    in property <string> title;
    spacing: 8px;
    SectionHeader {
        text: root.title;
    }
    Card {
        @children
    }
}

// Scrollable pane: page header + children stacked with 20px gaps.
// Fills its (non-layout) parent — children of a Rectangle don't stretch.
export component Pane inherits ScrollView {
    in property <string> title;
    in property <string> subtitle;

    width: 100%;
    height: 100%;

    VerticalLayout {
        padding-left: 36px;
        padding-right: 36px;
        padding-top: 24px;
        padding-bottom: 32px;
        spacing: 20px;
        alignment: start;

        VerticalLayout {
            spacing: 4px;
            padding-left: 2px;
            padding-bottom: 8px;
            alignment: start;
            Text {
                text: root.title;
                font-size: 26px;
                font-weight: 600;
                color: Palette.foreground;
            }
            Text {
                text: root.subtitle;
                font-size: 13px;
                color: UITheme.secondary;
                visible: root.subtitle != "";
            }
        }

        @children
    }
}

// Sidebar nav row: accent pill + glyph + label.
export component NavItem inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <bool> selected;
    callback clicked;

    height: 36px;
    border-radius: 6px;
    background: root.selected ? UITheme.accent-tint
        : (touch.has-hover ? UITheme.hover : transparent);

    Rectangle {
        x: 6px;
        y: (parent.height - 18px) / 2;
        width: 3px;
        height: 18px;
        border-radius: 1.5px;
        background: Palette.accent-background;
        opacity: root.selected ? 1 : 0;
    }

    HorizontalLayout {
        padding-left: 18px;
        padding-right: 10px;
        spacing: 12px;
        IconText {
            glyph: root.glyph;
            font-size: 15px;
            width: 20px;
            color: root.selected ? Palette.accent-background : Palette.foreground.with-alpha(0.75);
            vertical-alignment: center;
        }
        Text {
            text: root.label;
            font-size: 13px;
            font-weight: root.selected ? 600 : 400;
            color: root.selected ? Palette.accent-background : Palette.foreground;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => root.clicked();
    }
}

// Compact ghost icon button — per-row delete actions, quieter than a
// full std Button.
export component GhostButton inherits Rectangle {
    in property <string> text;
    callback clicked;

    width: 24px;
    height: 24px;
    border-radius: 4px;
    background: ta.has-hover ? UITheme.hover : transparent;

    Text {
        text: root.text;
        font-size: 11px;
        color: ta.has-hover ? Palette.foreground : UITheme.secondary;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }

    ta := TouchArea {
        clicked => root.clicked();
    }
}

// App-list card: description + exe rows + add/reset footer + running-apps picker.
export component AppListSection inherits VerticalLayout {
    in property <string> title;
    in property <string> desc;
    in property <[string]> items;
    in property <[string]> running-apps;
    in property <string> placeholder: "Tên tiến trình (vd: chrome.exe)";
    callback add(string);
    callback remove(string);
    callback reset();
    callback refresh-running();

    property <bool> show-running: false;

    spacing: 8px;

    SectionHeader {
        text: root.title;
    }

    Card {
        VerticalLayout {
            padding-left: 14px;
            padding-right: 14px;
            padding-top: 12px;
            padding-bottom: 4px;
            Text {
                text: root.desc;
                font-size: 11px;
                color: UITheme.secondary;
                wrap: word-wrap;
            }
        }

        if root.items.length == 0 : VerticalLayout {
            padding: 12px;
            Text {
                text: "Chưa có ứng dụng nào";
                font-size: 12px;
                color: UITheme.secondary;
                horizontal-alignment: center;
            }
        }

        for item[i] in root.items : VerticalLayout {
            spacing: 0px;
            if i > 0 : RowDivider {}
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 10px;
                padding-top: 7px;
                padding-bottom: 7px;
                spacing: 8px;
                Text {
                    text: item;
                    font-size: 12px;
                    color: Palette.foreground;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                GhostButton {
                    text: "✕";
                    clicked => root.remove(item);
                }
            }
        }

        RowDivider {}

        HorizontalLayout {
            padding-left: 14px;
            padding-right: 14px;
            padding-top: 10px;
            padding-bottom: 12px;
            spacing: 8px;
            entry := LineEdit {
                placeholder-text: root.placeholder;
                horizontal-stretch: 1;
                accepted => {
                    if (self.text != "") {
                        root.add(self.text);
                        self.text = "";
                    }
                }
            }
            Button {
                text: "＋ Thêm…";
                clicked => {
                    if (entry.text != "") {
                        root.add(entry.text);
                        entry.text = "";
                    }
                }
            }
            Button {
                text: "Reset mặc định";
                clicked => root.reset();
            }
        }

        RowDivider {}

        // Running-apps picker: expanding refreshes the process snapshot so
        // the list always shows what is running right now.
        HorizontalLayout {
            padding-left: 14px;
            padding-right: 14px;
            padding-top: 8px;
            padding-bottom: 8px;
            Button {
                text: root.show-running ? "▾ Ẩn app đang chạy" : "▸ Chọn từ app đang chạy…";
                clicked => {
                    if (!root.show-running) {
                        root.refresh-running();
                    }
                    root.show-running = !root.show-running;
                }
            }
        }

        if root.show-running : Rectangle {
            height: 176px;
            clip: true;
            ScrollView {
                width: 100%;
                height: 100%;
                VerticalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    padding-top: 4px;
                    padding-bottom: 8px;
                    spacing: 0px;

                    if root.running-apps.length == 0 : Text {
                        text: "Không đọc được danh sách tiến trình";
                        font-size: 12px;
                        color: UITheme.secondary;
                        horizontal-alignment: center;
                    }

                    for exe in root.running-apps : Rectangle {
                        height: 28px;
                        border-radius: 4px;
                        background: ta.has-hover ? UITheme.hover : transparent;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            Text {
                                text: exe;
                                font-size: 12px;
                                color: Palette.foreground;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                        ta := TouchArea {
                            clicked => root.add(exe);
                        }
                    }
                }
            }
        }
    }
}
